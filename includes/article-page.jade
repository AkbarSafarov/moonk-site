                                <button type="button" class="btn-light rounded-circle position-absolute" data-bs-toggle="tooltip" style="top: 50%; left: 80%;" data-bs-html="true" title="<b>Стол - Мольберт Malevich</b><br><span class='text-success'>31 320 ₽</span> <span class='text-muted text-decoration-line-through'>34 800 ₽</span>"></button>
                            </div>
