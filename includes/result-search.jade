</section>
<section class="content-padding filter_section">
    <div class="inner">
        <div class="d-flex gap-4" style="--bs-gutter-x: 16px;">
            <div class="col filter_btn">
                <div class="action_btn" data-bs-toggle="modal" data-bs-target="#filterModal" data-bs-dismiss="modal"><i class="bi bi-filter"></i>Фильтр</div>
            </div>
            <div class="col soart_btn">
                <div class="action_btn" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-soart"></i>по умолчанию</div>
