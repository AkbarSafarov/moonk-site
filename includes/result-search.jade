                    <li><a class="dropdown-item active" href="#" data-sort="default">По умолчанию</a></li>
                    <li><a class="dropdown-item" href="#" data-sort="price-asc">Возрастанию цены</a></li>
                    <li><a class="dropdown-item" href="#" data-sort="price-desc">Убыванию цены</a></li>
                    <li><a class="dropdown-item" href="#" data-sort="name-asc">Название A-Я</a></li>
                    <li><a class="dropdown-item" href="#" data-sort="name-desc">Название Я-А</a></li>
                </ul>
            </div>
            <div class="count_products">85 товаров</div>
            <div class="view_btn">
                <div class="thumb1 active"></div>
                <div class="thumb2"></div>
            </div>
        </div>
    </div>
</section>
